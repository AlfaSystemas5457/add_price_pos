<?xml version="1.0" encoding="utf-8"?>

<templates id="template"
    xml:space="preserve">

    <t t-name="add_price_pos.ProductCard_inherit"
        t-inherit="point_of_sale.ProductCard"
        t-inherit-mode="extension"
        owl="1">

        <xpath expr="//div[contains(@class, 'product-content')]"
            position="attributes">
            <attribute name="class">product-content h-100 px-2 rounded-bottom-3 flex-shrink-1 flex-column justify-content-center</attribute>
        </xpath>

        <xpath expr="//div[contains(@class,'product-content')]//div[contains(@class,'product-name')]"
            position="after">
            <separator t-if="props.product.list_price and !props.isComboPopup"/>
            <div class="monetary_price d-flex justify-content-start align-items-center mt-1"
                t-if="props.product.list_price and !props.isComboPopup">
                <span>$</span>
                <span class="product-price"
                    t-attf-id="article_product_price_{{props.productId}}"
                    t-esc="props.product.list_price" />
            </div>
        </xpath>

    </t>

</templates>